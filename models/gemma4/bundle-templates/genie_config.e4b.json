{
    "_comment": [
        "Gemma4-E4B bundle template. UNTESTED: no E4B context binaries exist on this box.",
        "Every value below is either identical to the validated E2B bundle or taken from",
        "assets/gemma-4-E4B-it-qat-mobile-ct-FP16/config.json (text_config).",
        "",
        "E4B vs E2B — the ONLY differences (inference logic is identical):",
        "  hidden_size            2560   (E2B 1536)  -> embedding.size",
        "  num_hidden_layers        42   (E2B   35)  -> inferred from the graphs",
        "  per-layer stream      10752   (E2B 8960)  = num_hidden_layers * 256",
        "  num_key_value_heads       2   (E2B    1)  -> inferred from the graphs",
        "Identical: vocab 262144, bos 2, eos [1,106], pad 0, head_dim 256 /",
        "global_head_dim 512, sliding_window 512, both RoPE blocks.",
        "",
        "TO USE: drop the E4B .serialized.bin shards and the two LUTs into this",
        "directory, fix ctx-bins / lut-path below, and replace BOTH quant-param",
        "blocks with the scale+offset from the export's embed_encodings.json and",
        "embed_tokens_encodings.json. The placeholders below are E2B's and WILL",
        "produce garbage tokens if left unchanged — a LUT encoding mismatch is the",
        "classic silent failure here.",
        "Also set datatype to match the exported LUT dtype (ufixed16 / ufixed8)."
    ],
    "dialog": {
        "version": 1,
        "type": "basic",
        "context": {
            "version": 1,
            "size": 4096,
            "n-vocab": 262144,
            "bos-token": 2,
            "eos-token": [
                1,
                106
            ],
            "pad-token": 0
        },
        "sampler": {
            "version": 1,
            "seed": 42,
            "temp": 0.8,
            "top-k": 40,
            "top-p": 0.95
        },
        "tokenizer": {
            "version": 1,
            "path": "tokenizer.json"
        },
        "engine": {
            "version": 1,
            "n-threads": 6,
            "backend": {
                "version": 1,
                "type": "QnnHtp",
                "QnnHtp": {
                    "version": 1,
                    "use-mmap": true,
                    "spill-fill-bufsize": 0,
                    "mmap-budget": 40,
                    "poll": true,
                    "cpu-mask": "0xfc0",
                    "kv-dim": 256,
                    "allow-async-init": true,
                    "enable-graph-switching": true
                }
            },
            "cache-groups": [
                {
                    "version": 1,
                    "prefix": "past_",
                    "kv-dim": 512,
                    "attention-mask-tensor-name": "attention_mask"
                },
                {
                    "version": 1,
                    "prefix": "swa_",
                    "kv-dim": 256,
                    "attention-mask-tensor-name": "swa_attention_mask",
                    "longcontext": {
                        "version": 1,
                        "type": "sliding-window",
                        "sliding-window": {
                            "version": 1,
                            "window-size": 512
                        }
                    }
                }
            ],
            "model": {
                "version": 1,
                "type": "binary",
                "positional-encoding": {
                    "type": "rope",
                    "rope-dim": 256,
                    "rope-theta": 1000000.0,
                    "rope-scaling": {
                        "rope-type": "proportional",
                        "partial-rotary-factor": 0.25
                    }
                },
                "local-positional-encoding": {
                    "type": "rope",
                    "rope-dim": 128,
                    "rope-theta": 10000.0
                },
                "binary": {
                    "version": 1,
                    "ctx-bins": [
                        "gemma4VL_weight_sharing_model_ar128_ar1_cl4096_1_of_2.serialized.bin",
                        "gemma4VL_weight_sharing_model_ar128_ar1_cl4096_2_of_2.serialized.bin"
                    ]
                }
            }
        },
        "embedding": {
            "version": 1,
            "type": "lut",
            "lut-path": "embedding_int16_lut.bin",
            "size": 2560,
            "datatype": "ufixed16",
            "quant-param": {
                "scale": 0.00019622829859144986,
                "offset": -43690
            }
        },
        "perlayer-embedding": {
            "version": 1,
            "type": "lut",
            "lut-path": "embed_token_int8_lut.bin",
            "size": 10752,
            "datatype": "ufixed8",
            "quant-param": {
                "scale": 0.09304534643888474,
                "offset": -136
            }
        }
    }
}
